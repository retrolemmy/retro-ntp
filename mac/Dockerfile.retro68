# Native (arm64 or x86_64) Retro68 toolchain, 68k only. The official ghcr.io/autc04/retro68 image is
# x86_64-only and its C++ tools fail under qemu-user on 16K-page kernels (Asahi), hence this.
#   docker build -t retro68-native -f mac/Dockerfile.retro68 mac
FROM debian:trixie
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates git cmake make gcc g++ bison flex texinfo ruby libboost-all-dev \
      libgmp-dev libmpfr-dev libmpc-dev zlib1g-dev xz-utils ninja-build python3 \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --recursive --shallow-submodules https://github.com/autc04/Retro68.git /Retro68
RUN mkdir /Retro68-build && cd /Retro68-build && /Retro68/build-toolchain.bash --no-ppc --no-carbon \
    && rm -rf /Retro68-build/build-* /Retro68-build/binutils-build /Retro68-build/gcc-build
